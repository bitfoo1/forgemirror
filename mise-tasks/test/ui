#!/usr/bin/env bash
#MISE description="Browser regression tests: live updates, responsive layout and axe accessibility checks"
#MISE depends=["setup:browsers"]
set -euo pipefail

# Resolve the mise-owned packages rather than maintaining a second npm toolchain.
playwright_modules="$(mise where npm:@playwright/test)/node_modules"
export NODE_PATH="${playwright_modules}:$(mise where npm:@axe-core/playwright)/node_modules${NODE_PATH:+:$NODE_PATH}"
tmp="$(mktemp -d)"
# A failed parallel gate can terminate Playwright before its server cleanup.
# Only this task owns a process whose executable is this unique temp path.
trap 'pkill -f "^${tmp}/ui-server$" 2>/dev/null || true; rm -rf "${tmp}"' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
go build -o "${tmp}/ui-server" ./internal/ui/testdata/server
export FORGEMIRROR_UI_TEST_SERVER="${tmp}/ui-server"
export FORGEMIRROR_UI_TEST_PORT
FORGEMIRROR_UI_TEST_PORT="$(node -e 'const s=require("node:net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')"
# Not the `playwright` bin: its shim overwrites NODE_PATH with Playwright's
# own directories, so specs could not require @axe-core/playwright.
node "${playwright_modules}/@playwright/test/cli.js" test --config tests/ui/playwright.config.cjs "$@"
