{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Toolchain pins in mise.toml: one PR per tool keeps a broken tool easy to spot.",
      "matchManagers": ["mise"],
      "semanticCommitScope": "mise"
    },
    {
      "description": "Go module updates.",
      "matchManagers": ["gomod"],
      "semanticCommitScope": "deps"
    }
  ],
  "customManagers": [
    {
      "description": "mise version installed in CI (.forgejo/workflows/ci.yaml).",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.forgejo/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["MISE_VERSION: (?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise"
    }
  ]
}
